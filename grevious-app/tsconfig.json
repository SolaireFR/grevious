{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowArbitraryExtensions": true,
    "moduleResolution": "bundler", /* Indique à TS que c'est Metro/Webpack qui gère les imports */
    "paths": {
      "@/*": [
        "./*",
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts" /* Force TS à lire ton fichier de déclarations */
  ]
}